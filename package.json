{
  "name": "fitapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:mobile": "pnpm --filter @fitapp/mobile start",
    "dev:web": "pnpm --filter @fitapp/mobile web",
    "dev:auth": "pnpm --filter @fitapp/auth dev",
    "dev:api": "pnpm --filter @fitapp/api dev",
    "dev:ai": "pnpm --filter @fitapp/ai dev",
    "dev:notifications": "pnpm --filter @fitapp/notifications dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc -b",
    "prepare": "node -e \"try{require('husky')}catch(e){}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "knip": "^5.42.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "metro-runtime": "^0.83.3"
  }
}
