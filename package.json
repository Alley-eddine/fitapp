{
  "name": "fitapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @fitapp/web dev",
    "dev:auth": "pnpm --filter @fitapp/auth dev",
    "dev:api": "pnpm --filter @fitapp/api dev",
    "dev:ai": "pnpm --filter @fitapp/ai dev",
    "dev:notifications": "pnpm --filter @fitapp/notifications dev",
    "dev:payment": "pnpm --filter @fitapp/payment dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc -b",
    "prepare": "node -e \"try{require('husky')}catch(e){}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.7",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "knip": "^5.42.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
