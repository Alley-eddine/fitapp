# =============================================================================
# Production environment — FitCoach AI
# =============================================================================
# Copy the values into Coolify (Environment Variables of the compose resource)
# and into Vercel (front). NEVER commit the filled-in file — this .example only
# documents the keys. Replace <DOMAIN> with your domain (e.g. fitcoach.app).
#
# Topology:
#   Front (Vercel)  →  https://<DOMAIN>
#   auth   (public) →  https://auth.<DOMAIN>
#   api    (public) →  https://api.<DOMAIN>
#   payment(public) →  https://pay.<DOMAIN>
#   ai, notifications, postgres, redis → internal only (Coolify private network)
# =============================================================================

# --- Database (Postgres runs inside the Coolify stack) -----------------------
POSTGRES_USER=fitapp
POSTGRES_PASSWORD=<STRONG_RANDOM_PASSWORD>
POSTGRES_DB=fitapp
# Internal DSN — "postgres" is the compose service name, not localhost.
DATABASE_URL=postgres://fitapp:<STRONG_RANDOM_PASSWORD>@postgres:5432/fitapp

# --- Shared secrets (identical across services) ------------------------------
JWT_SECRET=<64_HEX_CHARS_RANDOM>
JWT_EXPIRES_IN=7d
# Must be >= 16 chars. Same value for auth, api, notifications, payment.
INTERNAL_API_KEY=<32_HEX_CHARS_RANDOM>

# --- Public URLs -------------------------------------------------------------
FRONTEND_URL=https://<DOMAIN>
AUTH_PUBLIC_URL=https://auth.<DOMAIN>
PAYMENT_PUBLIC_URL=https://pay.<DOMAIN>

# --- Google OAuth (redirect URI must match in the Google Console) ------------
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_CALLBACK_URL=https://auth.<DOMAIN>/auth/google/callback

# --- AI (Groq) ---------------------------------------------------------------
GROQ_API_KEY=<groq_api_key>
FREE_TIER_DAILY_LIMIT=5
PRO_TIER_DAILY_LIMIT=50
PREMIUM_TIER_DAILY_LIMIT=200

# --- Notifications (Resend Pro + Twilio) -------------------------------------
RESEND_API_KEY=<resend_api_key>
# With Resend Pro + a verified domain, delivery works to any recipient.
EMAIL_FROM=FitCoach AI <no-reply@<DOMAIN>>
TWILIO_ACCOUNT_SID=<twilio_sid>
TWILIO_AUTH_TOKEN=<twilio_token>
TWILIO_FROM_NUMBER=<twilio_number>

# --- Payment (Stripe) --------------------------------------------------------
STRIPE_SECRET_KEY=<sk_live_or_test>
# Obtained from the Stripe dashboard webhook pointing at https://pay.<DOMAIN>/api/payment/webhook
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_PRO=<price_...>
STRIPE_PRICE_PREMIUM=<price_...>

# =============================================================================
# Vercel front (set these in the Vercel project, NOT in Coolify)
# =============================================================================
# NEXT_PUBLIC_AUTH_URL=https://auth.<DOMAIN>
# NEXT_PUBLIC_API_URL=https://api.<DOMAIN>
# NEXT_PUBLIC_PAYMENT_URL=https://pay.<DOMAIN>
